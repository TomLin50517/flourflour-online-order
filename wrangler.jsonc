{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flourflour-online-order",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // 見 docs/OPEN-QUESTIONS.md：透過 `npx wrangler hyperdrive create` 建立，
  // 上游接 Supabase 的 Direct connection（見該指令的說明）。
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c3e4cf1358434f15a3a425b85826c342"
    }
  ]
}
